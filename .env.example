# Firebase Configuration for Smart Soleh
# Copy this file to .env.local and fill in your Firebase project values
# These values are obtained from your Firebase Project Settings

# Firebase API Key (from Firebase Console > Project Settings > General tab)
VITE_FIREBASE_API_KEY=your_api_key_here

# Firebase Auth Domain (usually: your-project-id.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com

# Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your_project_id

# Firebase Storage Bucket (usually: your-project-id.appspot.com)
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com

# Firebase Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id

# Firebase App ID
VITE_FIREBASE_APP_ID=your_app_id

# Optional: Initial auth token for demo purposes
VITE_INITIAL_AUTH_TOKEN=

# Optional: Custom app ID (defaults to 'smart-soleh-app')
VITE_APP_ID=smart-soleh-app
